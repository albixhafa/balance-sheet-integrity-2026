# Copy to .env and fill in. Never commit .env.

# Used by docker-compose.local.yml to create the database and build DATABASE_URL.
POSTGRES_USER=bsi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=balance_sheet_db

# Only needed when running outside Docker (npm run dev / prisma commands).
DATABASE_URL=postgresql://bsi:change-me@localhost:5432/balance_sheet_db

# Where attachments are stored. Defaults to ./storage/attachments. Keep it
# outside anything a web server serves: files are only returned through
# /balancesheet/api/attachments/<id> after an access check.
# STORAGE_DIR=/app/storage/attachments

# Set to "false" only when serving over plain HTTP (local testing).
# COOKIE_SECURE=false
