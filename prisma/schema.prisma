// prisma/schema.prisma
//
// Every change since the original schema is ADDITIVE: new tables and new
// nullable columns only. Nothing is renamed or dropped, so the existing data
// and the old app keep working against this database during the cutover.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Role {
  ASSEMBLER
  REVIEWER
  APPROVER
  ADMIN
  SUPER_ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum RecStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// --- MODELS ---

model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique // always stored lower-case
  passwordHash           String
  requiresPasswordChange Boolean  @default(true)
  failedLoginAttempts    Int      @default(0)
  isLockedOut            Boolean  @default(false)
  role                   Role     @default(ASSEMBLER)
  status                 Status   @default(ACTIVE)
  isReadOnly             Boolean  @default(false)
  createdAt              DateTime @default(now())

  entities    Entity[]
  approvals   Approval[]
  sessions    Session[]
  auditEvents AuditEvent[]
  attachments Attachment[]
}

// Server-side sessions. The cookie carries a random 256-bit token; only its
// SHA-256 is stored here, so a database leak does not yield usable sessions.
// Deleting a row signs that browser out immediately - which is how
// deactivation and password resets take effect without waiting for expiry.
model Session {
  id         String   @id // sha256(token), hex
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Entity {
  id        String   @id @default(cuid())
  code      String   @unique // exactly 6 upper-case alphanumerics, e.g. "ABC001"
  name      String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())

  users        User[]
  glAccounts   GLAccount[]
  transactions Transaction[]
}

model GLAccount {
  id          String   @id // exactly 12 digits, e.g. "100120000000"
  description String
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())

  entityCode String
  entity     Entity @relation(fields: [entityCode], references: [code])

  // The 10 sub-account dimension labels, configured per GL
  sub1Name  String?
  sub2Name  String?
  sub3Name  String?
  sub4Name  String?
  sub5Name  String?
  sub6Name  String?
  sub7Name  String?
  sub8Name  String?
  sub9Name  String?
  sub10Name String?

  transactions    Transaction[]
  reconciliations AccountReconciliation[]
}

model FinancialPeriod {
  id          String    @id // YYYYMM
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  closedById  String?

  transactions    Transaction[]
  reconciliations AccountReconciliation[]
}

model Transaction {
  id             String   @id @default(cuid())
  txnDate        String // YYYYMMDD
  amount         Decimal  @db.Decimal(12, 2)
  description    String?
  reference      String?
  supportFileUrl String? // legacy: a file NAME only, from before real uploads existed
  cleared        Boolean  @default(false)
  createdAt      DateTime @default(now())

  sub1Value  String?
  sub2Value  String?
  sub3Value  String?
  sub4Value  String?
  sub5Value  String?
  sub6Value  String?
  sub7Value  String?
  sub8Value  String?
  sub9Value  String?
  sub10Value String?

  entityCode String
  entity     Entity @relation(fields: [entityCode], references: [code])

  glId      String
  glAccount GLAccount @relation(fields: [glId], references: [id])

  periodId String
  period   FinancialPeriod @relation(fields: [periodId], references: [id])

  // The real supporting document, when one has been uploaded. Several lines
  // can share one file ("apply this backup to all selected").
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])

  // Set when final approval rolls an uncleared line into the next period, to
  // the period it came from. Reopening that period moves exactly these lines
  // back - and nothing that was imported into the next period directly.
  rolledFromPeriodId String?

  approvals Approval[]

  @@unique([entityCode, glId, txnDate, reference, amount])
  @@index([glId, periodId])
}

// Legacy table from the original design; never written to. Kept so the
// existing schema and data stay intact.
model Approval {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([userId, transactionId])
}

model AccountReconciliation {
  id     String    @id @default(cuid())
  status RecStatus @default(PENDING)

  glId      String
  glAccount GLAccount @relation(fields: [glId], references: [id])

  periodId String
  period   FinancialPeriod @relation(fields: [periodId], references: [id])

  assemblerId String?
  assembledAt DateTime?
  reviewerId  String?
  reviewedAt  DateTime?
  approverId  String?
  approvedAt  DateTime?

  @@unique([glId, periodId])
}

// Append-only record of everything that changes state: sign-offs, undos,
// rejections (with reasons), reopenings (with reasons), clearing, attachments,
// imports and every administrative change. Nothing in the app updates or
// deletes these rows.
model AuditEvent {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  entityCode   String?
  glId         String?
  periodId     String?
  targetUserId String?
  detail       Json?

  @@index([glId, periodId])
  @@index([at])
}

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  storageKey   String   @unique
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  transactions Transaction[]
}
